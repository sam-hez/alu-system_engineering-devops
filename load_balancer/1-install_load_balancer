#!/usr/bin/env bash
# Installs HAProxy and configures round-robin traffic distribution between two web servers.

apt-get update
apt-get install -y haproxy

cat > /etc/haproxy/haproxy.cfg <<'HAPROXY_CONFIG'
global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend http_front
    bind *:80
    default_backend web_servers

backend web_servers
    balance roundrobin
    server 7104-web-01 3.93.24.212:80 check
    server 7104-web-02 54.89.145.102:80 check
HAPROXY_CONFIG

if grep -q '^ENABLED=' /etc/default/haproxy; then
    sed -i 's/^ENABLED=.*/ENABLED=1/' /etc/default/haproxy
else
    printf '%s\n' 'ENABLED=1' >> /etc/default/haproxy
fi

haproxy -c -f /etc/haproxy/haproxy.cfg
systemctl enable haproxy
service haproxy restart