#!/usr/bin/env bash
# Configures Nginx to run as the nginx user and listen on IPv4 port 8080.
id -u nginx >/dev/null 2>&1 || useradd --system --no-create-home --shell /usr/sbin/nologin nginx
sed -i 's/user www-data;/user nginx;/' /etc/nginx/nginx.conf
sed -i 's/listen 80 default_server;/listen 8080 default_server;/' /etc/nginx/sites-enabled/default
pkill apache2 || true
pkill nginx || true
mkdir -p /var/lib/nginx /var/log/nginx
chown -R nginx:nginx /var/lib/nginx /var/log/nginx
install -o nginx -g nginx -m 0644 /dev/null /run/nginx.pid
sudo -u nginx /usr/sbin/nginx
